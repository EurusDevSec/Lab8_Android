<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InputDataActivity">

    <TextView
        android:id="@+id/tvNhapSo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Nhập số: "
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edtNhapSo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:hint="Nhập số vào ô"
        android:inputType="number"
        android:textColor="#FFFFFF"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvNhapSo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvNhapSo" />

    <Button
        android:id="@+id/btnLuuBinhPhuong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Luu Bình Phương"
        android:backgroundTint="#00674F"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLuuSoGoc"
        app:layout_constraintTop_toBottomOf="@id/edtNhapSo"

        />
    <Button
        android:id="@+id/btnLuuSoGoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="#00674F"
        android:textColor="#FFFFFF"
        android:text="Lưu số Gốc"
        app:layout_constraintStart_toEndOf="@id/btnLuuBinhPhuong"
        app:layout_constraintTop_toBottomOf="@id/edtNhapSo"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>